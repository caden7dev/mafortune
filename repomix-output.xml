                    const SizedBox(height: 16),
                    _buildPieLegend('📉', 'Dépensé', _totalDepenses, const Color(0xFFC62828)),
                    const SizedBox(height: 16),
                    _buildPieLegend('📊', 'Total', total, Colors.grey[700]!),
