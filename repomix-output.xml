                  fontWeight: FontWeight.bold,
                  color: Colors.black87,
                ),
              ),
            ],
          ),
          const SizedBox(height: 16),
          child,
        ],
      ),
    );
  }

  // ─── PARAGRAPHE ──────────────────────────────────────────────────────────────
  Widget _buildParagraph(String text) {
    return Text(
