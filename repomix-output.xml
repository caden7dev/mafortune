                              child: _buildMiniStat(
                                '📈', 'Gagné',
                                '+${_formatAmount(_quickStats['todayIncome'] ?? 0)} F',
                                Colors.greenAccent,
                              ),
                            ),
                            Container(
                                width: 1, height: 40,
