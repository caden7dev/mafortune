          Text(
            value,
            style: const TextStyle(
              fontSize: 14,
              fontWeight: FontWeight.w600,
              color: Colors.black87,
            ),
          ),
        ],
      ),
    );
  }

  // ─── CREDIT ITEM ─────────────────────────────────────────────────────────────
  Widget _buildCreditItem(String name, String emoji, String role) {
    return Padding(
