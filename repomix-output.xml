                          radius: _touchedPieIndex == 1 ? 70 : 58,
                          titleStyle: const TextStyle(
                            color: Colors.white,
                            fontWeight: FontWeight.bold,
                            fontSize: 13,
                          ),
                        ),
                      ],
                      centerSpaceRadius: 36,
                      sectionsSpace: 3,
                    ),
