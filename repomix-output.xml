            child: Center(
              child: Text(emoji, style: const TextStyle(fontSize: 22)),
            ),
          ),

          const SizedBox(width: 14),

          // Texte
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
